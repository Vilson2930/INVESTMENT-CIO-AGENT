{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Investment CIO Agent Output",
  "description": "Contrato universal de comunicação entre os motores quantitativos e o Investment CIO Agent.",
  "type": "object",

  "required": [
    "schema_version",
    "system_id",
    "system_name",
    "generated_at",
    "status",
    "decision",
    "metrics",
    "risk",
    "data_quality"
  ],

  "properties": {

    "schema_version": {
      "type": "string"
    },

    "system_id": {
      "type": "string"
    },

    "system_name": {
      "type": "string"
    },

    "generated_at": {
      "type": "string",
      "format": "date-time"
    },

    "status": {
      "type": "string",
      "enum": [
        "OK",
        "WARNING",
        "ERROR",
        "DATA_INSUFFICIENT"
      ]
    },

    "decision": {
      "type": "object",

      "required": [
        "signal",
        "confidence"
      ],

      "properties": {

        "signal": {
          "type": "string"
        },

        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },

        "summary": {
          "type": ["string", "null"]
        }
      },

      "additionalProperties": true
    },

    "metrics": {
      "type": "object",
      "additionalProperties": true
    },

    "risk": {
      "type": "object",

      "properties": {

        "level": {
          "type": ["string", "null"]
        },

        "score": {
          "type": ["number", "null"]
        },

        "alerts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },

      "additionalProperties": true
    },

    "data_quality": {
      "type": "object",

      "properties": {

        "score": {
          "type": ["number", "null"]
        },

        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },

      "additionalProperties": true
    },

    "positions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },

    "opportunities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },

    "audit": {
      "type": "object",
      "additionalProperties": true
    },

    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },

  "additionalProperties": false
}
